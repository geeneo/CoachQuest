# Copy to .env on the server and fill in. .env is never committed.

# ---- App ----
APP_NAME=coachquest
COMPOSE_PROJECT=coachquest
APP_PORT=3040
# Public URL users open in the browser (used for OAuth redirects and cookies)
PUBLIC_BASE_URL=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/coachquest.db
# open | closed  (closed = only ADMIN_EMAILS may register)
REGISTRATION_MODE=open
# Comma-separated emails that get the admin flag on registration
ADMIN_EMAILS=
# true when the site is served over HTTPS (it should be)
COOKIE_SECURE=true
SESSION_TTL_HOURS=336

# ---- Reverse proxy <-> API trust ----
# Long random string shared by nginx and the API. nginx sends it with every
# request; the API rejects identity headers that arrive without it.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=

# ---- Encryption of provider tokens at rest ----
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Strava (https://www.strava.com/settings/api) ----
# Authorization Callback Domain must match the host of PUBLIC_BASE_URL
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Anthropic (backend only, never in VITE_*) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ---- Git access on the server (prefer an SSH deploy key) ----
GIT_TOKEN=
