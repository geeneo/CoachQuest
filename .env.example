# Copy to .env on the server and fill in. .env is never committed.

# ---- App ----
APP_NAME=coachquest
COMPOSE_PROJECT=coachquest
APP_PORT=3040
# Public URL users open in the browser (used for OAuth redirects and cookies)
PUBLIC_BASE_URL=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/coachquest.db
# Postgres instead (docs/postgres.md has the steps and the way back), with the password below:
# DATABASE_URL=postgresql+psycopg://coachquest:PASSWORD@db/coachquest
# Password for the Postgres container; letters, digits, - and _ only (it goes in the URL above).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Comma-separated emails that get the admin flag on registration.
# Needed for the first admin; after that, promote users on the Admin page.
ADMIN_EMAILS=
# Comma-separated emails of super admins (they approve sign-ups when
# "Super admin approves new sign-ups" is on). Empty: the ADMIN_EMAILS accounts.
SUPER_ADMIN_EMAILS=
# true when the site is served over HTTPS (it should be)
COOKIE_SECURE=true
SESSION_TTL_HOURS=336

# ---- Reverse proxy <-> API trust ----
# Long random string shared by nginx and the API. nginx sends it with every
# request; the API rejects identity headers that arrive without it.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=

# ---- Encryption of provider tokens at rest ----
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Everything below can instead be set on the Admin page in the web UI.
# A value saved there wins over .env and is stored encrypted with
# TOKEN_ENCRYPTION_KEY. Leave these blank if you'll use the Admin page.
# ---------------------------------------------------------------------------

# open | closed  (closed = only ADMIN_EMAILS may register)
REGISTRATION_MODE=open
# on: the sign-up page and a welcome email say this is an alpha and access is subject to approval.
# Super admins can switch it under Admin → Settings → Accounts.
ALPHA_NOTICE=off

# ---- Strava (https://www.strava.com/settings/api) ----
# Authorization Callback Domain must match the host of PUBLIC_BASE_URL
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Anthropic (backend only, never in VITE_*) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ---- Email (password reset, weekly reviews) ----
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Workout platforms ----
# Intervals.icu OAuth app (also settable in Admin > Settings). Sends scheduled workouts to
# Intervals.icu, which forwards them to Zwift. Apply at https://intervals.icu/oauth/apply.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# Unofficial MyWhoosh API. Leave off: it stays off until MyWhoosh's terms are checked.
MYWHOOSH_EXPERIMENTAL=false

# ---- Git access on the server (prefer an SSH deploy key) ----
GIT_TOKEN=
